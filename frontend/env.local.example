# Template frontend untuk menjalankan di komputer lokal.
# Salin menjadi frontend/.env. REACT_APP_BACKEND_URL sengaja KOSONG: frontend memanggil /api
# di localhost:3000 dan src/setupProxy.js meneruskannya ke backend (satu origin → cookie & CSRF lolos).
REACT_APP_BACKEND_URL=
# Alamat backend untuk proxy dev (default http://localhost:8001)
LOCAL_BACKEND_URL=http://localhost:8001
