# Template backend untuk menjalankan di komputer lokal.
# Salin menjadi backend/.env lalu isi JWT_SECRET (lihat docs/LOCAL_SETUP.md).
MONGO_URL=mongodb://localhost:27017
DB_NAME=fnb_erp_local
# Wajib. Buat string acak panjang, mis.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGINS=http://localhost:3000
# http://localhost (bukan https) → cookie login tidak boleh berflag Secure
COOKIE_SECURE=false
# Fitur AI butuh EMERGENT_LLM_KEY; biarkan false bila tidak punya key
FEATURE_AI_ENABLED=false
EMERGENT_LLM_KEY=
# Job terjadwal (digest Telegram, dll.) tidak perlu di lokal
SCHEDULER_ENABLED=false
RATE_LIMIT_BYPASS_LOOPBACK=true
WHATSAPP_PROVIDER=mock
