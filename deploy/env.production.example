# Salin ke root repo sebagai `.env` (sudah di-.gitignore — JANGAN di-commit), lalu isi.
#   cp deploy/env.production.example .env
# File ini dibaca docker compose dan diteruskan ke container backend.

# ── Wajib ────────────────────────────────────────────────────────────────────
# Domain aplikasi. Arahkan DNS (A record) ke IP server; Caddy mengambil sertifikat HTTPS otomatis.
# Pakai ":80" untuk uji tanpa domain / bila HTTPS sudah ditangani proxy lain di depan.
SITE_ADDRESS=erp.contoh.com
# Origin publik aplikasi (skema + domain, tanpa garis miring di akhir).
CORS_ORIGINS=https://erp.contoh.com
# String acak panjang. Buat: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Kunci enkripsi secret di database (API key integrasi). Buat:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   (tanpa python: openssl rand -base64 32 | tr '+/' '-_')
# SIMPAN baik-baik: bila hilang/berganti, API key yang tersimpan di Admin → Integrations harus diisi ulang.
SECRETS_ENCRYPTION_KEY=

# ── Umum ─────────────────────────────────────────────────────────────────────
DB_NAME=fnb_erp
TIMEZONE=Asia/Jakarta
# Cookie login hanya dikirim lewat HTTPS. Set false HANYA untuk uji via http://<IP> tanpa domain.
COOKIE_SECURE=true
# Jumlah proxy tepercaya di depan backend (Caddy = 1). Tambah 1 bila ada Cloudflare/load balancer di depan Caddy.
TRUSTED_PROXY_HOPS=1
# Port di host (ubah bila 80/443 sudah dipakai, mis. HTTP_PORT=8080 untuk uji lokal).
HTTP_PORT=80
HTTPS_PORT=443
MAX_UPLOAD_SIZE_MB=10
SCHEDULER_ENABLED=true

# ── Opsional: integrasi (bisa juga diisi di Admin → Integrations) ─────────────
FEATURE_AI_ENABLED=true
# ANTHROPIC_API_KEY=
# local (volume `uploads`) atau s3 (isi kredensial di Admin → Integrations)
STORAGE_BACKEND=local
# evolution / fonnte / twilio / meta; mock = tidak mengirim apa pun
WHATSAPP_PROVIDER=mock
# RESEND_API_KEY=
# EMAIL_FROM=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_OPS_CHAT_ID=
